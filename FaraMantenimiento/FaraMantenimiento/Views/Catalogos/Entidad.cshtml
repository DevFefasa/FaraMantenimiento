@using System.Collections
@using FM.OrigenDatos.Modelos.Catalogos
@* Callers: CatalogosController.Entidad
   API: lista + data-fara-modal Crear/Editar; Activar via FaraComun.ajaxPost; Excel activos
   Schema: acciones PRIMERA; fara-badge-activo/inactivo; --fara-badge-color
   Confirm: reescribe Views/Catalogos/Entidad.cshtml existente (script suelto → @section Scripts)
   User instruction: "el <script> de Views/Catalogos/Entidad.cshtml esta suelto... Moverlos a @section Scripts" *@
@{
    var tipo = (string)(ViewData["Tipo"] ?? "");
    var titulo = ViewData["Title"] as string ?? "Catálogo";
    var items = Model as IEnumerable ?? Array.Empty<object>();
}
@Html.AntiForgeryToken()
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <a asp-action="Index" class="small text-decoration-none">← Catálogos</a>
        <h1 class="h4 mb-0">@titulo</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (tipo == "activos")
        {
            <a class="btn btn-outline-secondary" asp-action="PlantillaActivos" style="min-height:40px">Plantilla Excel</a>
            <label class="btn btn-outline-primary mb-0" style="min-height:40px;cursor:pointer">Cargar Excel<input type="file" id="fileExcel" accept=".xlsx,.xls" class="d-none" /></label>
        }
        @if (tipo != "estados")
        {
            <a class="btn btn-primary" asp-action="Crear" asp-route-tipo="@tipo"
               data-fara-modal data-fara-titulo="Nuevo · @titulo" style="min-height:40px">Nuevo</a>
        }
    </div>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle fara-tabla-movil">
<thead><tr>
<th class="fara-col-accion">Acciones</th>
@switch (tipo) {
    case "regiones": <th>Código</th><th>Nombre</th><th>Estado</th> break;
    case "sucursales": <th>Código</th><th>Nombre</th><th>Tipo</th><th>Región</th><th>Estado</th> break;
    case "ubicaciones": <th>Código</th><th>Nombre</th><th>Sucursal</th><th>Estado</th> break;
    case "activos": <th>Código</th><th>Nombre</th><th>Sucursal</th><th>Categoría</th><th>Estado</th> break;
    case "tipos": case "categorias": case "motivos": <th>Código</th><th>Nombre</th><th>Orden</th><th>Estado</th> break;
    case "prioridades": <th>Código</th><th>Nombre</th><th>Color</th><th>Resp. (h)</th><th>Sol. (h)</th><th>Estado</th> break;
    case "estados": <th>Código</th><th>Nombre</th><th>Color</th><th>Orden</th><th>Estado</th> break;
    case "proveedores": <th>Código</th><th>Nombre</th><th>Especialidad</th><th>Estado</th> break;
    case "tecnicos": <th>Código</th><th>Nombre</th><th>Categoría</th><th>Estado</th> break;
    case "parametros": <th>Clave</th><th>Valor</th><th>Descripción</th><th>Estado</th> break;
}
</tr></thead>
<tbody>
@foreach (dynamic row in items)
{
    bool activo = (bool)row.FbActivo;
    int id = (int)row.FiId;
<tr>
<td class="fara-col-accion" data-label="Acciones">
    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-tipo="@tipo" asp-route-id="@id"
       data-fara-modal data-fara-titulo="Editar · @titulo" style="min-height:40px">Editar</a>
    <button type="button" class="btn btn-sm @(activo ? "btn-outline-danger" : "btn-outline-success") btn-activar"
            data-id="@id" data-activo="@(activo ? "false" : "true")" style="min-height:40px">
        @(activo ? "Desactivar" : "Activar")
    </button>
</td>
@switch (tipo) {
    case "regiones":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "sucursales":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Tipo">@row.FcTipo</td><td data-label="Región">@row.FcRegionNombre</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "ubicaciones":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Sucursal">@row.FcSucursalNombre</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "activos":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Sucursal">@row.FcSucursalNombre</td><td data-label="Categoría">@row.FcCategoriaNombre</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "tipos": case "categorias": case "motivos":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Orden">@row.FiOrden</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "prioridades":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td>
        <td data-label="Color"><span class="fara-badge" style="--fara-badge-color:@(row.FcColor ?? "#6c757d")">@(row.FcCodigo)</span></td>
        <td data-label="Resp. (h)">@row.FiHorasRespuesta</td><td data-label="Sol. (h)">@row.FiHorasSolucion</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "estados":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td>
        <td data-label="Color"><span class="fara-badge" style="--fara-badge-color:@(row.FcColor ?? "#6c757d")">@(row.FcCodigo)</span></td>
        <td data-label="Orden">@row.FiOrden</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "proveedores":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Especialidad">@row.FcEspecialidad</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "tecnicos":
        <td data-label="Código">@row.FcCodigo</td><td data-label="Nombre">@row.FcNombre</td><td data-label="Categoría">@row.FcCategoriaNombre</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
    case "parametros":
        <td data-label="Clave">@row.FcClave</td><td data-label="Valor">@row.FcValor</td><td data-label="Descripción">@row.FcDescripcion</td>
        <td data-label="Estado">@if (activo) { <span class="fara-badge fara-badge-activo">Activo</span> } else { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }</td>
        break;
}
</tr>
}
</tbody>
</table>
</div>

@section Scripts {
<script>
(function () {
    var tipo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipo));

    function syncColor(root) {
        var p = (root || document).querySelector('#fcColorPicker');
        var h = (root || document).querySelector('#fcColor');
        if (!p || !h) return;
        p.addEventListener('input', function () { h.value = p.value; });
        h.addEventListener('change', function () {
            if (/^#[0-9A-Fa-f]{6}$/.test(h.value)) p.value = h.value;
        });
    }
    function hookModal() {
        var el = document.getElementById('faraModal');
        if (!el) return false;
        el.addEventListener('fara:modal-cargado', function () { syncColor(el); });
        return true;
    }
    if (!hookModal()) {
        var obs = new MutationObserver(function () {
            if (hookModal()) obs.disconnect();
        });
        obs.observe(document.body, { childList: true });
    }

    document.querySelectorAll('.btn-activar').forEach(function (btn) {
        btn.addEventListener('click', function () {
            FaraComun.ajaxPost('/Catalogos/Activar', {
                tipo: tipo,
                id: btn.getAttribute('data-id'),
                activo: btn.getAttribute('data-activo') === 'true'
            }).then(function (r) {
                if (r.FbSucces || r.fbSucces) setTimeout(function () { location.reload(); }, 700);
            });
        });
    });

    var file = document.getElementById('fileExcel');
    if (file) {
        file.addEventListener('change', function () {
            if (!file.files.length) return;
            var fd = new FormData();
            fd.append('archivo', file.files[0]);
            FaraComun.ajaxPost('/Catalogos/CargarActivos', fd).then(function (r) {
                if (r.FbSucces || r.fbSucces) setTimeout(function () { location.reload(); }, 900);
            });
        });
    }
})();
</script>
}
