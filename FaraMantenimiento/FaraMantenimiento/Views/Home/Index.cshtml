@{
    ViewData["Title"] = "Inicio";
    ViewData["SinTarjeta"] = true;
    bool Tiene(string p) => User.HasClaim("permiso", p);
    var nombre = User.FindFirst("nombre")?.Value ?? User.Identity?.Name ?? "usuario";
}
<div class="mb-4">
    <h1 class="h3 mb-1">Bienvenido, @nombre</h1>
    <p class="text-muted mb-0">FaraFix · Ferretería Faraj (FEFASA)</p>
</div>

<div class="row g-3">
@if (Tiene("DASHBOARD"))
{
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a class="fara-acceso" href="/Dashboard"><i class="ti ti-layout-dashboard"></i><span>Dashboard</span><small class="text-muted">Indicadores y SLA</small></a>
    </div>
}
@if (User.Claims.Any(c => c.Type == "permiso" && c.Value.StartsWith("TICKET_")))
{
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a class="fara-acceso" href="/Tickets"><i class="ti ti-ticket"></i><span>Tickets</span><small class="text-muted">Creados, asignados, por aprobar y por atender</small></a>
    </div>
}
@if (Tiene("CATALOGOS"))
{
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a class="fara-acceso" href="/Catalogos"><i class="ti ti-books"></i><span>Catálogos</span><small class="text-muted">Sucursales, tipos y más</small></a>
    </div>
}
@if (Tiene("REPORTES"))
{
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a class="fara-acceso" href="/Reportes"><i class="ti ti-chart-bar"></i><span>Reportes</span><small class="text-muted">Indicadores y exportaciones</small></a>
    </div>
}
@if (Tiene("SEGURIDAD"))
{
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a class="fara-acceso" href="/Seguridad"><i class="ti ti-shield-lock"></i><span>Seguridad</span><small class="text-muted">Usuarios, roles y permisos</small></a>
    </div>
}
</div>

@if (!User.Claims.Any(c => c.Type == "permiso"))
{
    <div class="alert alert-warning mt-4 mb-0">
        No tiene pantallas asignadas. Solicite acceso al administrador de seguridad.
    </div>
}
