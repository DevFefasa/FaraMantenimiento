@model FaraMantenimiento.ViewModels.Preventivos.PreventivoListaViewModel
@* Callers: PreventivosController.Index
   API: lista + data-fara-modal Crear/Editar; Activar/GenerarAhora con FaraComun toast; @section Scripts
   Schema: acciones PRIMERA; fara-badge-activo/inactivo; Desactivar btn-outline-danger
   Confirm: reescribe Index.cshtml existente (quita msgBox y script suelto con bootstrap)
   User instruction: "PREVENTIVOS: el usuario no puede hacer el CRUD... Desactivar rojo, badge... toast... Quitar los div .alert de Index y Calendario" *@
@{
    ViewData["Title"] = "Planes preventivos";
    var combos = Model.Combos;
}
@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Planes preventivos</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Calendario" style="min-height:40px">Calendario</a>
        <button type="button" class="btn btn-outline-primary" id="btnGenerar" style="min-height:40px"
                title="Genera ya los tickets de planes vencidos; también se ejecuta solo cada día">Generar ahora</button>
        <a class="btn btn-primary" asp-action="Crear" data-fara-modal data-fara-titulo="Nuevo plan" style="min-height:40px">Nuevo plan</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <select name="sucursalId" class="form-select" onchange="this.form.submit()">
            <option value="">Todas las sucursales</option>
            @if (combos != null)
            {
                foreach (var s in combos.Sucursales)
                {
                    if (Model.SucursalId == s.FiId) { <option value="@s.FiId" selected>@s.FcNombre</option> }
                    else { <option value="@s.FiId">@s.FcNombre</option> }
                }
            }
        </select>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle fara-tabla-movil">
        <thead>
            <tr>
                <th class="fara-col-accion">Acciones</th>
                <th>Nombre</th>
                <th>Sucursal</th>
                <th>Activo</th>
                <th>Frecuencia</th>
                <th>Próxima</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Planes.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">No hay planes registrados.</td></tr>
        }
        else
        {
            foreach (var p in Model.Planes)
            {
                <tr>
                    <td class="fara-col-accion" data-label="Acciones">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.FiId"
                           data-fara-modal data-fara-titulo="Editar plan" style="min-height:40px">Editar</a>
                        <button type="button" class="btn btn-sm @(p.FbActivo ? "btn-outline-danger" : "btn-outline-success") btn-activar"
                                data-id="@p.FiId" data-activo="@(p.FbActivo ? "false" : "true")" style="min-height:40px">
                            @(p.FbActivo ? "Desactivar" : "Activar")
                        </button>
                    </td>
                    <td data-label="Nombre">@p.FcNombre</td>
                    <td data-label="Sucursal">@p.FcSucursalNombre</td>
                    <td data-label="Activo">@(p.FcActivoNombre ?? "—")</td>
                    <td data-label="Frecuencia">cada @p.FiFrecuenciaDias días</td>
                    <td data-label="Próxima">@p.FdProximaFecha.ToString("dd/MM/yyyy")</td>
                    <td data-label="Estado">
                        @if (p.FbActivo)
                        { <span class="fara-badge fara-badge-activo">Activo</span> }
                        else
                        { <span class="fara-badge fara-badge-inactivo">Inactivo</span> }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
(function () {
    function initFiltros(root) {
        root = root || document;
        var ubiEl = root.querySelector('#prev-ubicaciones');
        var actEl = root.querySelector('#prev-activos');
        if (!ubiEl || !actEl) return;
        var ubicaciones = JSON.parse(ubiEl.textContent || '[]');
        var activos = JSON.parse(actEl.textContent || '[]');
        var suc = root.querySelector('#FiSucursalId');
        var ubiSel = root.querySelector('#FiUbicacionId');
        var actSel = root.querySelector('#FiActivoId');
        if (!suc || !ubiSel || !actSel) return;

        function filtrar() {
            var s = suc.value;
            var ubiActual = ubiSel.value;
            var actActual = actSel.value;
            ubiSel.innerHTML = '<option value="">(Opcional)</option>';
            ubicaciones.filter(function (u) { return !s || String(u.FiSucursalId) === String(s); }).forEach(function (u) {
                var o = document.createElement('option');
                o.value = u.FiId; o.textContent = u.FcNombre;
                if (String(u.FiId) === String(ubiActual)) o.selected = true;
                ubiSel.appendChild(o);
            });
            var ubi = ubiSel.value;
            actSel.innerHTML = '<option value="">(Opcional)</option>';
            activos.filter(function (a) {
                return (!s || String(a.FiSucursalId) === String(s)) && (!ubi || !a.FiUbicacionId || String(a.FiUbicacionId) === String(ubi));
            }).forEach(function (a) {
                var o = document.createElement('option');
                o.value = a.FiId; o.textContent = a.FcNombre;
                if (String(a.FiId) === String(actActual)) o.selected = true;
                actSel.appendChild(o);
            });
        }
        suc.addEventListener('change', filtrar);
        ubiSel.addEventListener('change', filtrar);
    }

    function hookModal() {
        var el = document.getElementById('faraModal');
        if (!el) return false;
        el.addEventListener('fara:modal-cargado', function () { initFiltros(el); });
        return true;
    }
    if (!hookModal()) {
        var obs = new MutationObserver(function () {
            if (hookModal()) obs.disconnect();
        });
        obs.observe(document.body, { childList: true });
    }

    document.querySelectorAll('.btn-activar').forEach(function (btn) {
        btn.addEventListener('click', function () {
            FaraComun.ajaxPost('/Preventivos/Activar', {
                id: btn.getAttribute('data-id'),
                activo: btn.getAttribute('data-activo') === 'true'
            }).then(function (r) {
                if (r.FbSucces || r.fbSucces) setTimeout(function () { location.reload(); }, 700);
            });
        });
    });

    document.getElementById('btnGenerar').addEventListener('click', function () {
        FaraComun.ajaxPost('/Preventivos/GenerarAhora', {}).then(function (r) {
            if (r.FbSucces || r.fbSucces) setTimeout(function () { location.reload(); }, 800);
        });
    });
})();
</script>
}
