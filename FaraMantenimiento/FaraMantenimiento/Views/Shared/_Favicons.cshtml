  Sin lectura/escritura de datos.
  Logo oficial: fuente en wwwroot/Logo (copiado a assets/images, icons y raíz).
*@
<link rel="icon" type="image/png" href="~/assets/images/fara-icono.png" sizes="192x192" asp-append-version="true" />
<link rel="icon" type="image/png" href="~/assets/images/FefasaIco.png" sizes="96x96" asp-append-version="true" />
<link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
<link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
