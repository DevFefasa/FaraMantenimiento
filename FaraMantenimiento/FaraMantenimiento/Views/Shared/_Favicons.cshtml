@*
  Callers: Views/Shared/_Layout.cshtml, Views/Shared/_LayoutLogin.cshtml via <partial name="_Favicons" />.
  No existing partial for favicons (Glob: solo _Layout y _ValidationScriptsPartial).
  Sin lectura/escritura de datos.
  Instrucción: "_Favicons" / "Poppins, FefasaLogo.png, FefasaIco.png" / "fara-icono.png, para menu colapsado, favicon grande y apple-touch-icon"
*@
<link rel="icon" type="image/png" href="~/assets/images/fara-icono.png" sizes="192x192" asp-append-version="true" />
<link rel="icon" type="image/png" href="~/assets/images/FefasaIco.png" sizes="96x96" asp-append-version="true" />
<link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
<link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
<meta name="theme-color" content="#1B5E35" />
