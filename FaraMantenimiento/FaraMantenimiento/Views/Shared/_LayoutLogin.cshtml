<!DOCTYPE html>
<html lang="es" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fara Mantenimiento</title>
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/assets/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/fara-identidad.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/libs/sweetalert2/dist/sweetalert2.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()
    <div class="text-center pb-4">
        <partial name="_Footer" />
    </div>
    <script src="~/assets/libs/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.min.js" asp-append-version="true"></script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
