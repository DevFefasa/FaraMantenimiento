@*
  Callers: Views/Shared/_Layout.cshtml (<partial name="_Header" />).
  No existe _Header (Glob Shared sin él).
  Claims: "nombre", ClaimTypes.Role. Form POST /Account/Logout + antiforgery.
  Instrucción: "_Header con nombre (claim \"nombre\"), rol (ClaimTypes.Role) y boton cerrar sesion (form POST /Account/Logout con antiforgery)."
*@
@using System.Security.Claims
@{
    var nombre = User.FindFirst("nombre")?.Value
        ?? User.FindFirst(ClaimTypes.GivenName)?.Value
        ?? User.Identity?.Name
        ?? "";
    var rol = User.FindFirst(ClaimTypes.Role)?.Value;
}
<header class="topbar sticky-top">
    <div class="with-vertical">
        <nav class="navbar navbar-expand-lg p-0 flex-nowrap align-items-center">
            <ul class="navbar-nav flex-row align-items-center flex-shrink-0">
                <li class="nav-item">
                    <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)"
                       aria-label="Abrir o cerrar menú">
                        <div class="nav-icon-hover-bg rounded-circle">
                            <i class="ti ti-menu-2 fs-7"></i>
                        </div>
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center justify-content-between flex-grow-1 min-w-0 ms-2">
                <span class="fw-semibold d-none d-md-inline text-primary">Fara Mantenimiento</span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-center flex-shrink-0 gap-2">
                        @* Callers: AlertasSlaViewComponent. Instrucción etapa 5: campana SLA junto al usuario. *@
                        @await Component.InvokeAsync("AlertasSla")
                        <li class="nav-item d-flex align-items-center">
                            <span class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center me-2"
                                  style="width:40px;height:40px;" aria-hidden="true">
                                <i class="ti ti-user"></i>
                            </span>
                            <span class="d-none d-sm-block text-end me-2">
                                <span class="fara-header-nombre d-block">@nombre</span>
                                @if (!string.IsNullOrWhiteSpace(rol))
                                {
                                    <span class="fara-header-rol">@rol</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="fara-btn-salir" title="Cerrar sesión">
                                    <i class="ti ti-logout"></i>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </nav>
    </div>
</header>
