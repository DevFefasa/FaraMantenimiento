@model FaraMantenimiento.ViewModels.Tickets.TicketDetalleViewModel
@{
    var t = Model.Ticket;
    var a = Model.Acciones;
    var combos = Model.Combos;
    ViewData["Title"] = t.FcNumero;
    string Lps(decimal? n) => n.HasValue ? $"L {n.Value:N2}" : "L 0.00";
    var sem = (t.FcSemaforoSla ?? "VERDE").ToLowerInvariant();
    static string ColorSeguro(string? c) =>
        !string.IsNullOrWhiteSpace(c) && System.Text.RegularExpressions.Regex.IsMatch(c, "^#[0-9a-fA-F]{3,8}$") ? c : "#6c757d";
    var puedeEvidencia = ViewBag.PuedeEvidencia is true;
    // La ejecución es un solo resumen por ticket: "Registrar" si está vacío, "Editar" si ya tiene datos.
    var tieneEjecucion = t.FdFechaInicio.HasValue || t.FdFechaFin.HasValue || t.FnHorasTrabajadas.HasValue
        || (t.FnCostoManoObra ?? 0) != 0 || (t.FnCostoProveedor ?? 0) != 0
        || !string.IsNullOrWhiteSpace(t.FcDiagnostico) || !string.IsNullOrWhiteSpace(t.FcCausaRaiz)
        || !string.IsNullOrWhiteSpace(t.FcTrabajoRealizado) || !string.IsNullOrWhiteSpace(t.FcAccionesPreventivas);
    var esResuelto = string.Equals(t.FcEstadoCodigo, "RESUELTO", StringComparison.OrdinalIgnoreCase);
    var diasCierre = ViewBag.DiasCierreAutomatico as int?;
    // Si ya se midió el SLA (respuesta/solución), se indica si se cumplió.
    static Microsoft.AspNetCore.Html.IHtmlContent SlaCumplido(bool? cumplido) => cumplido switch
    {
        true => new Microsoft.AspNetCore.Html.HtmlString("<span class=\"fara-badge\" style=\"--fara-badge-color:#16a34a\">Cumplido</span>"),
        false => new Microsoft.AspNetCore.Html.HtmlString("<span class=\"fara-badge\" style=\"--fara-badge-color:#dc2626\">No cumplido</span>"),
        _ => Microsoft.AspNetCore.Html.HtmlString.Empty
    };
}
@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">
            <span class="fara-semaforo fara-semaforo-@sem me-1" title="@t.FcSemaforoSla"></span>
            @t.FcNumero
        </h1>
        <div class="d-flex flex-wrap gap-2">
            @* Callers: TicketsController.Detalle. Schema: FcEstadoColor/FcPrioridadColor. Instrucción: badges estado.fcColor. *@
            <span class="fara-badge" style="--fara-badge-color:@ColorSeguro(t.FcEstadoColor)">@t.FcEstadoNombre</span>
            <span class="fara-badge" style="--fara-badge-color:@ColorSeguro(t.FcPrioridadColor)">@t.FcPrioridadNombre</span>
            @if (t.FbReincidencia)
            {
                <span class="fara-badge" style="--fara-badge-color:#d97706">Reincidencia@(string.IsNullOrEmpty(t.FcTicketReincidenteNumero) ? "" : $" · {t.FcTicketReincidenteNumero}")</span>
            }
        </div>
    </div>
    <a class="btn btn-outline-secondary" href="javascript:history.back()" style="min-height:40px">Volver</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Descripción</h2>
            <p class="mb-0" style="white-space:pre-wrap">@t.FcDescripcion</p>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Datos</h2>
            <div class="row g-2 small">
                <div class="col-6 col-md-4"><strong>Ingreso</strong><div>@t.FdFechaIngreso.ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="col-6 col-md-4"><strong>Solicitante</strong><div>@t.FcSolicitanteNombre</div></div>
                <div class="col-6 col-md-4"><strong>Cargo</strong><div>@(string.IsNullOrWhiteSpace(t.FcCargo) ? "—" : t.FcCargo)</div></div>
                <div class="col-6 col-md-4"><strong>Correo</strong><div class="text-break">@if (string.IsNullOrWhiteSpace(t.FcCorreo)) { <span>—</span> } else { <a href="mailto:@t.FcCorreo">@t.FcCorreo</a> }</div></div>
                <div class="col-6 col-md-4"><strong>Teléfono</strong><div>@(string.IsNullOrWhiteSpace(t.FcTelefono) ? "—" : t.FcTelefono)</div></div>
                <div class="col-6 col-md-4"><strong>Sucursal</strong><div>@t.FcSucursalNombre</div></div>
                <div class="col-6 col-md-4"><strong>Área / Departamento</strong><div>@(t.FcAreaNombre ?? "—") / @(t.FcDepartamentoNombre ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Ubicación</strong><div>@(t.FcUbicacionNombre ?? t.FcUbicacionDetalle ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Activo</strong><div>@(t.FcActivoNombre ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Tipo</strong><div>@t.FcTipoNombre</div></div>
                <div class="col-6 col-md-4"><strong>Categoría</strong><div>@t.FcCategoriaNombre</div></div>
                @if (t.FdFechaSugerida.HasValue)
                {
                    <div class="col-6 col-md-4"><strong>Fecha sugerida</strong><div>@t.FdFechaSugerida.Value.ToString("dd/MM/yyyy HH:mm")</div></div>
                }
                <div class="col-6 col-md-4"><strong>Límite respuesta</strong><div>@(t.FdLimiteRespuesta?.ToString("dd/MM/yyyy HH:mm") ?? "—") @SlaCumplido(t.FbSlaRespuestaCumplido)</div></div>
                <div class="col-6 col-md-4"><strong>Límite solución</strong><div>@(t.FdLimiteSolucion?.ToString("dd/MM/yyyy HH:mm") ?? "—") @SlaCumplido(t.FbSlaSolucionCumplido)</div></div>
                <div class="col-6 col-md-4"><strong>Responsable</strong><div>@if (string.IsNullOrWhiteSpace(t.FcTipoResponsable)) { <span class="text-muted">Sin asignar</span> } else { @(t.FcTipoResponsable == "INTERNO" ? t.FcTecnicoNombre : t.FcProveedorNombre) <small class="text-muted">(@(t.FcTipoResponsable == "INTERNO" ? "Técnico interno" : "Proveedor externo"))</small> }</div></div>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Ejecución y costos</h2>
            <div class="row g-2 small mb-2">
                <div class="col-6 col-md-3"><strong>Programada</strong><div>@(t.FdFechaProgramada?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Inicio</strong><div>@(t.FdFechaInicio?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Fin</strong><div>@(t.FdFechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Horas</strong><div>@(t.FnHorasTrabajadas?.ToString("N2") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Mano de obra</strong><div>@Lps(t.FnCostoManoObra)</div></div>
                <div class="col-6 col-md-3"><strong>Materiales</strong><div>@Lps(t.FnCostoMateriales)</div></div>
                <div class="col-6 col-md-3"><strong>Proveedor</strong><div>@Lps(t.FnCostoProveedor)</div></div>
            </div>
            <p class="small mb-1"><strong>Diagnóstico:</strong> @(t.FcDiagnostico ?? "—")</p>
            <p class="small mb-1"><strong>Causa raíz:</strong> @(t.FcCausaRaiz ?? "—")</p>
            <p class="small mb-1"><strong>Trabajo:</strong> @(t.FcTrabajoRealizado ?? "—")</p>
            @if (!string.IsNullOrWhiteSpace(t.FcAccionesPreventivas))
            {
                <p class="small mb-0"><strong>Preventivas:</strong> @t.FcAccionesPreventivas</p>
            }
        </div>

        @*
          Callers: Tickets/Detalle. API: tabla materiales + fcCodigoSap. Schema: ticketmaterial (mig 91).
          Confirm: claude2 toca otras secciones; solo materiales/proveedor aquí.
          User instruction: "Puedes editar Views/Tickets/Detalle.cshtml SOLO en las secciones de materiales y de proveedor"
        *@
        <div class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 mb-0">Materiales</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-sm fara-tabla-movil">
                    <thead><tr><th>SAP</th><th>Descripción</th><th>Cant.</th><th>Costo</th><th>Total</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.Materiales)
                    {
                        <tr>
                            <td data-label="SAP">@(m.FcCodigoSap ?? "—")</td>
                            <td data-label="Descripción">@m.FcDescripcion</td>
                            <td data-label="Cant.">@m.FnCantidad @m.FcUnidad</td>
                            <td data-label="Costo">@Lps(m.FnCostoUnitario)</td>
                            <td data-label="Total">@Lps(m.FnTotal)</td>
                        </tr>
                    }
                    @if (!Model.Materiales.Any()) { <tr><td colspan="5" class="text-muted">Sin materiales</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Adjuntos</h2>
            @{
                var etapas = new[] { ("SOLICITUD", "Solicitud"), ("ANTES", "Antes"), ("DESPUES", "Después") };
            }
            @foreach (var (cod, titulo) in etapas)
            {
                var grupo = Model.Adjuntos.Where(x => string.Equals(x.FcEtapa, cod, StringComparison.OrdinalIgnoreCase)).ToList();
                if (grupo.Count > 0)
                {
                    <h3 class="h6 text-muted mt-2">@titulo</h3>
                    <div class="row g-2 mb-2">
                        @foreach (var ad in grupo)
                        {
                            <div class="col-6 col-md-4">
                                <a href="/Adjuntos/Ver/@ad.FiId" target="_blank" class="d-block border rounded p-2 small">
                                    <span class="fara-badge">@ad.FcEtapa</span><br />@ad.FcNombreOriginal
                                </a>
                            </div>
                        }
                    </div>
                }
            }
            @if (!Model.Adjuntos.Any()) { <p class="text-muted small mb-0">Sin adjuntos</p> }
            @if (a.PuedeAdjuntos)
            {
                <hr />
                <form id="formAdjunto" class="m-0">
                    <div class="mb-2">
                        <span class="form-label d-block mb-1">Etapa</span>
                        <div class="btn-group flex-wrap" role="group" aria-label="Etapa del adjunto">
                            <input type="radio" class="btn-check" name="etapa" id="etapaSolicitud" value="SOLICITUD" checked />
                            <label class="btn btn-outline-primary" for="etapaSolicitud" style="min-height:40px">Solicitud</label>
                            @if (puedeEvidencia)
                            {
                                <input type="radio" class="btn-check" name="etapa" id="etapaAntes" value="ANTES" />
                                <label class="btn btn-outline-primary" for="etapaAntes" style="min-height:40px">Antes</label>
                                <input type="radio" class="btn-check" name="etapa" id="etapaDespues" value="DESPUES" />
                                <label class="btn btn-outline-primary" for="etapaDespues" style="min-height:40px">Después</label>
                            }
                        </div>
                    </div>
                    @{
                        ViewData["InputName"] = "archivos";
                        ViewData["Label"] = "Archivos";
                    }
                    <partial name="_AdjuntosInput" />
                    <button type="submit" class="btn btn-primary fara-btn-subir" id="btnSubirAdjuntos" style="min-height:40px">
                        <i class="ti ti-upload me-1"></i>Subir archivos
                    </button>
                </form>
            }
        </div>

        @* RESUELTO: el solicitante valida el trabajo (mismo SP de encuesta: conforme → VALIDADO; no conforme → EN_PROCESO). *@
        @if (a.PuedeEncuesta)
        {
            <div class="border rounded p-3 mb-3 border-success fara-validar" id="cardValidar">
                <h2 class="h5 mb-1">Validar trabajo</h2>
                <p class="mb-3">Mantenimiento marcó el ticket como resuelto. ¿Quedó solucionado?</p>
                <form id="formEncuesta" class="m-0">
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <input type="radio" class="btn-check" name="conforme" id="conformeSi" value="true" autocomplete="off" />
                            <label class="btn btn-outline-success w-100 fara-btn-validar" for="conformeSi"><i class="ti ti-circle-check fs-5 me-1"></i>Sí, quedó bien</label>
                        </div>
                        <div class="col-12 col-sm-6">
                            <input type="radio" class="btn-check" name="conforme" id="conformeNo" value="false" autocomplete="off" />
                            <label class="btn btn-outline-danger w-100 fara-btn-validar" for="conformeNo"><i class="ti ti-circle-x fs-5 me-1"></i>No, sigue el problema</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span class="form-label d-block" id="lblEstrellas">Califique la atención (1 a 5)</span>
                        <div class="d-flex gap-1 flex-wrap" id="estrellas" role="radiogroup" aria-labelledby="lblEstrellas">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="fara-estrella btn-estrella" data-val="@i" role="radio" aria-checked="false" aria-label="@i de 5">★</button>
                            }
                            <span class="ms-2 align-self-center small text-muted" id="txtEstrellas"></span>
                        </div>
                        <input type="hidden" name="calificacion" id="calificacion" value="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="txtValidar" id="lblComentarioValidar">Comentario (opcional)</label>
                        <textarea name="comentario" id="txtValidar" class="form-control" rows="2" placeholder="Cuéntenos cómo quedó el trabajo"></textarea>
                    </div>
                    <button class="btn btn-success" id="btnValidar" style="min-height:44px">Enviar</button>
                </form>
                @if (diasCierre is > 0)
                {
                    <p class="small text-muted mb-0 mt-3"><i class="ti ti-clock me-1"></i>Si no responde en @diasCierre día@(diasCierre == 1 ? "" : "s"), el ticket se cierra solo.</p>
                }
            </div>
        }
        else if (esResuelto)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="status">
                <i class="ti ti-hourglass fs-5"></i>
                <span>Esperando validación del solicitante.@(diasCierre is > 0 ? $" Si no responde en {diasCierre} día{(diasCierre == 1 ? "" : "s")}, el ticket se cierra solo." : "")</span>
            </div>
        }
        @if (!a.PuedeEncuesta && Model.Encuesta != null)
        {
            <div class="border rounded p-3 mb-3">
                <h2 class="h6">Validación del solicitante</h2>
                <p class="mb-0">Calificación: @Model.Encuesta.FiCalificacion / 5 · @(Model.Encuesta.FbConforme ? "Conforme" : "No conforme")</p>
                <p class="small text-muted mb-0">@Model.Encuesta.FcComentario</p>
            </div>
        }
    </div>

    <div class="col-12 col-lg-4">
        <div class="border rounded p-3 mb-3 fara-acciones-ticket">
            <h2 class="h6">Acciones</h2>
            <div class="d-grid gap-2">
                @if (a.PuedeEvaluar) { <button type="button" class="btn btn-outline-primary js-estado" data-estado="EN_EVALUACION" style="min-height:40px">Pasar a evaluación</button> }
                @if (a.PuedeAprobar) { <button type="button" class="btn btn-success js-estado" data-estado="APROBADO" style="min-height:40px">Aprobar</button> }
                @if (a.PuedeRechazar) { <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalRechazo" style="min-height:40px">Rechazar</button> }
                @if (a.PuedeCambiarPrioridad) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalPrioridad" style="min-height:40px">Cambiar prioridad</button> }
                @if (a.PuedeAsignar) { <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignar" style="min-height:40px">Asignar</button> }
                @if (a.PuedeIniciar) { <button type="button" class="btn btn-primary js-estado" data-estado="EN_PROCESO" style="min-height:40px">Iniciar trabajo</button> }
                @if (a.PuedePonerEspera) { <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEspera" style="min-height:40px">Poner en espera</button> }
                @if (a.PuedeSalirEspera) { <button type="button" class="btn btn-outline-primary js-estado" data-estado="EN_PROCESO" style="min-height:40px">Salir de espera</button> }
                @if (a.PuedeEjecucion) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEjecucion" style="min-height:40px">@(tieneEjecucion ? "Editar ejecución" : "Registrar ejecución")</button> }
                @if (a.PuedeMateriales) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalMaterial" style="min-height:40px">Agregar material</button> }
                @if (a.PuedeResolver) { <button type="button" class="btn btn-success js-estado" data-estado="RESUELTO" style="min-height:40px">Marcar resuelto</button> }
                @if (a.PuedeCerrar) { <button type="button" class="btn btn-dark js-estado" data-estado="CERRADO" style="min-height:40px">Cerrar</button> }
                @if (!(a.PuedeEvaluar || a.PuedeAprobar || a.PuedeRechazar || a.PuedeCambiarPrioridad || a.PuedeAsignar || a.PuedeIniciar || a.PuedePonerEspera || a.PuedeSalirEspera || a.PuedeEjecucion || a.PuedeMateriales || a.PuedeResolver || a.PuedeCerrar))
                {
                    <p class="small text-muted mb-0">No tiene acciones pendientes en el estado "@t.FcEstadoNombre".</p>
                }
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Línea de tiempo</h2>
            <ul class="list-unstyled small mb-0">
            @* Lo más nuevo arriba. Una fila sin cambio de estado (p. ej. "Ejecución registrada") se titula con su comentario. *@
            @foreach (var h in Model.Historial.OrderByDescending(x => x.FdFecha).ThenByDescending(x => x.FiId))
            {
                var sinCambio = h.FiEstadoAnteriorId.HasValue && h.FiEstadoAnteriorId == h.FiEstadoId && !string.IsNullOrWhiteSpace(h.FcComentario);
                <li class="mb-3 border-start border-3 ps-2" style="border-color:@(sinCambio ? "#9aa0a6" : ColorSeguro(h.FcEstadoColor)) !important">
                    @if (sinCambio)
                    {
                        <div class="fw-semibold">@h.FcComentario</div>
                        <div class="text-muted">@h.FdFecha.ToString("dd/MM/yyyy HH:mm") · @(h.FcUsuarioNombre ?? "Sistema") · estado @h.FcEstadoNombre</div>
                    }
                    else
                    {
                        <div class="fw-semibold">@h.FcEstadoNombre</div>
                        <div class="text-muted">@h.FdFecha.ToString("dd/MM/yyyy HH:mm") · @(h.FcUsuarioNombre ?? "Sistema")</div>
                    }
                    @if (!sinCambio && !string.IsNullOrWhiteSpace(h.FcComentario)) { <div>@h.FcComentario</div> }
                    @if (!string.IsNullOrWhiteSpace(h.FcMotivoEsperaNombre)) { <div class="text-warning">Motivo: @h.FcMotivoEsperaNombre</div> }
                </li>
            }
            </ul>
        </div>

        <div class="border rounded p-3">
            <h2 class="h6">Comentarios</h2>
            @foreach (var c in Model.Comentarios)
            {
                <div class="mb-2 small @(c.FbInterno ? "bg-light p-2 rounded" : "")">
                    <div class="fw-semibold">@(c.FcUsuarioNombre ?? "Usuario") @(c.FbInterno ? "(interno)" : "")</div>
                    <div class="text-muted">@c.FdFecha.ToString("dd/MM/yyyy HH:mm")</div>
                    <div>@c.FcComentario</div>
                </div>
            }
            <form id="formComentario" class="mt-2">
                <textarea name="comentario" class="form-control mb-2" rows="2" required placeholder="Escriba un comentario"></textarea>
                @if (User.IsInRole("MANTENIMIENTO") || User.IsInRole("JEFATURA") || User.IsInRole("ADMIN"))
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="interno" value="true" id="interno" />
                        <label class="form-check-label" for="interno">Interno</label>
                    </div>
                }
                <button class="btn btn-outline-primary btn-sm" style="min-height:40px">Agregar</button>
            </form>
        </div>
    </div>
</div>

@* Modales *@
<div class="modal fade" id="modalRechazo" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Rechazar ticket</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <label class="form-label" for="txtRechazo">Motivo del rechazo</label>
        <textarea id="txtRechazo" class="form-control" rows="3" placeholder="Explique al solicitante por qué no se aprueba"></textarea>
    </div>
    <div class="modal-footer"><button class="btn btn-danger" id="btnRechazo" style="min-height:40px">Confirmar rechazo</button></div>
</div></div></div>

<div class="modal fade" id="modalEspera" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Poner en espera</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label" for="selMotivo">Motivo de la espera</label>
            <select id="selMotivo" class="form-select">
                @if (combos != null) { foreach (var m in combos.MotivosEspera) { <option value="@m.FiId">@m.FcNombre</option> } }
            </select>
        </div>
        <div>
            <label class="form-label" for="txtEspera">Comentario</label>
            <textarea id="txtEspera" class="form-control" rows="2" placeholder="Qué se espera y para cuándo"></textarea>
            <div class="form-text">El tiempo en espera no cuenta para el SLA.</div>
        </div>
    </div>
    <div class="modal-footer"><button class="btn btn-warning" id="btnEspera" style="min-height:40px">Confirmar</button></div>
</div></div></div>

<div class="modal fade" id="modalPrioridad" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Cambiar prioridad</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <label class="form-label" for="selPrioridad">Nueva prioridad</label>
        <select id="selPrioridad" class="form-select">
            @if (combos != null)
            {
                foreach (var p in combos.Prioridades)
                {
                    if (p.FiId == t.FiPrioridadId)
                    {
                        <option value="@p.FiId" selected>@p.FcNombre</option>
                    }
                    else
                    {
                        <option value="@p.FiId">@p.FcNombre</option>
                    }
                }
            }
        </select>
        <div class="form-text">Los límites de SLA se recalculan con la nueva prioridad.</div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnPrioridad" style="min-height:40px">Guardar</button></div>
</div></div></div>

<div class="modal fade" id="modalAsignar" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Asignar responsable</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label" for="selTipoResp">Tipo de responsable</label>
            <select id="selTipoResp" class="form-select" data-no-select2>
                <option value="INTERNO">Técnico interno</option>
                <option value="PROVEEDOR">Proveedor externo</option>
            </select>
            <div class="form-text">Proveedor externo solo si el trabajo lo hace una empresa contratada.</div>
        </div>
        @* Sin select2: el toggle de técnico/proveedor oculta el select nativo y select2 lo dejaba visible *@
        <div class="mb-3" id="wrapTecnico">
            <label class="form-label" for="selTecnico">Técnico</label>
            <select id="selTecnico" class="form-select" data-no-select2>
                <option value="">Seleccione un técnico...</option>
                @if (combos != null) { foreach (var x in combos.Tecnicos) { <option value="@x.FiId">@x.FcNombre</option> } }
            </select>
        </div>
        @* Callers: modalAsignar. API: BuscarProveedoresSap. Schema: ticket.fcProveedorSap*. User: "proveedores se toman de... SAP... catálogo local deja de usarse para elegir" *@
        <div id="wrapProveedorSap" class="mb-3" style="display:none">
            <label class="form-label" for="selProveedorSap">Proveedor</label>
            <select id="selProveedorSap" class="form-select" data-select2-ajax data-placeholder="Buscar proveedor SAP (mín. 2 letras)">
                <option value=""></option>
            </select>
            <input type="hidden" id="provSapCodigo" />
            <input type="hidden" id="provSapNombre" />
            <div id="sapProvError" class="small text-danger mt-1" style="display:none"></div>
        </div>
        <div>
            <label class="form-label" for="fdProgramada">Fecha programada de atención</label>
            <div class="input-group">
                <input type="datetime-local" id="fdProgramada" class="form-control" lang="es" />
                <button type="button" class="btn btn-outline-secondary fara-btn-ahora" data-fara-ahora="#fdProgramada" title="Poner la fecha y hora actual" aria-label="Ahora"><i class="ti ti-clock"></i><span class="d-none d-sm-inline ms-1">Ahora</span></button>
            </div>
            <div class="form-text">Cuándo se planea atender el trabajo (opcional). Se incluye en el correo de asignación al responsable y al solicitante.</div>
        </div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnAsignar" style="min-height:40px">Asignar</button></div>
</div></div></div>

<div class="modal fade" id="modalEjecucion" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header">
        <div>
            <h5 class="modal-title">@(tieneEjecucion ? "Editar ejecución" : "Registrar ejecución")</h5>
            <div class="small text-muted">Se actualiza el resumen de ejecución del ticket.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body row g-3">
        <div class="col-md-6">
            <label class="form-label" for="ejInicio">Inicio</label>
