                <input type="datetime-local" id="ejInicio" class="form-control" lang="es" value="@(t.FdFechaInicio?.ToString("yyyy-MM-ddTHH:mm"))" />
                <button type="button" class="btn btn-outline-secondary fara-btn-ahora" data-fara-ahora="#ejInicio" title="Poner la fecha y hora actual" aria-label="Ahora"><i class="ti ti-clock"></i><span class="d-none d-sm-inline ms-1">Ahora</span></button>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="ejFin">Fin</label>
