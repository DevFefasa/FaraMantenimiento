@model FaraMantenimiento.ViewModels.Tickets.TicketDetalleViewModel
@{
    var t = Model.Ticket;
    var a = Model.Acciones;
    var combos = Model.Combos;
    ViewData["Title"] = t.FcNumero;
    string Lps(decimal? n) => n.HasValue ? $"L {n.Value:N2}" : "L 0.00";
    var sem = (t.FcSemaforoSla ?? "VERDE").ToLowerInvariant();
    static string ColorSeguro(string? c) =>
        !string.IsNullOrWhiteSpace(c) && System.Text.RegularExpressions.Regex.IsMatch(c, "^#[0-9a-fA-F]{3,8}$") ? c : "#6c757d";
    var puedeEvidencia = ViewBag.PuedeEvidencia is true;
}
@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">
            <span class="fara-semaforo fara-semaforo-@sem me-1" title="@t.FcSemaforoSla"></span>
            @t.FcNumero
        </h1>
        <div class="d-flex flex-wrap gap-2">
            @* Callers: TicketsController.Detalle. Schema: FcEstadoColor/FcPrioridadColor. Instrucción: badges estado.fcColor. *@
            <span class="fara-badge" style="--fara-badge-color:@ColorSeguro(t.FcEstadoColor)">@t.FcEstadoNombre</span>
            <span class="fara-badge" style="--fara-badge-color:@ColorSeguro(t.FcPrioridadColor)">@t.FcPrioridadNombre</span>
            @if (t.FbReincidencia)
            {
                <span class="fara-badge" style="--fara-badge-color:#d97706">Reincidencia@(string.IsNullOrEmpty(t.FcTicketReincidenteNumero) ? "" : $" · {t.FcTicketReincidenteNumero}")</span>
            }
        </div>
    </div>
    <a class="btn btn-outline-secondary" href="javascript:history.back()" style="min-height:40px">Volver</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Descripción</h2>
            <p class="mb-0" style="white-space:pre-wrap">@t.FcDescripcion</p>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Datos</h2>
            <div class="row g-2 small">
                <div class="col-6 col-md-4"><strong>Ingreso</strong><div>@t.FdFechaIngreso.ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="col-6 col-md-4"><strong>Solicitante</strong><div>@t.FcSolicitanteNombre</div></div>
                <div class="col-6 col-md-4"><strong>Sucursal</strong><div>@t.FcSucursalNombre</div></div>
                <div class="col-6 col-md-4"><strong>Ubicación</strong><div>@(t.FcUbicacionNombre ?? t.FcUbicacionDetalle ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Activo</strong><div>@(t.FcActivoNombre ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Tipo</strong><div>@t.FcTipoNombre</div></div>
                <div class="col-6 col-md-4"><strong>Categoría</strong><div>@t.FcCategoriaNombre</div></div>
                <div class="col-6 col-md-4"><strong>Límite respuesta</strong><div>@(t.FdLimiteRespuesta?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Límite solución</strong><div>@(t.FdLimiteSolucion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-4"><strong>Responsable</strong><div>@(t.FcTipoResponsable == "INTERNO" ? t.FcTecnicoNombre : t.FcProveedorNombre) @(t.FcTipoResponsable)</div></div>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Ejecución y costos</h2>
            <div class="row g-2 small mb-2">
                <div class="col-6 col-md-3"><strong>Inicio</strong><div>@(t.FdFechaInicio?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Fin</strong><div>@(t.FdFechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Horas</strong><div>@(t.FnHorasTrabajadas?.ToString("N2") ?? "—")</div></div>
                <div class="col-6 col-md-3"><strong>Mano de obra</strong><div>@Lps(t.FnCostoManoObra)</div></div>
                <div class="col-6 col-md-3"><strong>Materiales</strong><div>@Lps(t.FnCostoMateriales)</div></div>
                <div class="col-6 col-md-3"><strong>Proveedor</strong><div>@Lps(t.FnCostoProveedor)</div></div>
            </div>
            <p class="small mb-1"><strong>Diagnóstico:</strong> @(t.FcDiagnostico ?? "—")</p>
            <p class="small mb-1"><strong>Causa raíz:</strong> @(t.FcCausaRaiz ?? "—")</p>
            <p class="small mb-1"><strong>Trabajo:</strong> @(t.FcTrabajoRealizado ?? "—")</p>
            @if (!string.IsNullOrWhiteSpace(t.FcAccionesPreventivas))
            {
                <p class="small mb-0"><strong>Preventivas:</strong> @t.FcAccionesPreventivas</p>
            }
        </div>

        <div class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 mb-0">Materiales</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-sm fara-tabla-movil">
                    <thead><tr><th>Descripción</th><th>Cant.</th><th>Costo</th><th>Total</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.Materiales)
                    {
                        <tr>
                            <td data-label="Descripción">@m.FcDescripcion</td>
                            <td data-label="Cant.">@m.FnCantidad @m.FcUnidad</td>
                            <td data-label="Costo">@Lps(m.FnCostoUnitario)</td>
                            <td data-label="Total">@Lps(m.FnTotal)</td>
                        </tr>
                    }
                    @if (!Model.Materiales.Any()) { <tr><td colspan="4" class="text-muted">Sin materiales</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Adjuntos</h2>
            @{
                var etapas = new[] { ("SOLICITUD", "Solicitud"), ("ANTES", "Antes"), ("DESPUES", "Después") };
            }
            @foreach (var (cod, titulo) in etapas)
            {
                var grupo = Model.Adjuntos.Where(x => string.Equals(x.FcEtapa, cod, StringComparison.OrdinalIgnoreCase)).ToList();
                if (grupo.Count > 0)
                {
                    <h3 class="h6 text-muted mt-2">@titulo</h3>
                    <div class="row g-2 mb-2">
                        @foreach (var ad in grupo)
                        {
                            <div class="col-6 col-md-4">
                                <a href="/Adjuntos/Ver/@ad.FiId" target="_blank" class="d-block border rounded p-2 small">
                                    <span class="fara-badge">@ad.FcEtapa</span><br />@ad.FcNombreOriginal
                                </a>
                            </div>
                        }
                    </div>
                }
            }
            @if (!Model.Adjuntos.Any()) { <p class="text-muted small mb-0">Sin adjuntos</p> }
            @if (a.PuedeAdjuntos)
            {
                <hr />
                <form id="formAdjunto" class="m-0">
                    <div class="mb-2">
                        <span class="form-label d-block mb-1">Etapa</span>
                        <div class="btn-group flex-wrap" role="group" aria-label="Etapa del adjunto">
                            <input type="radio" class="btn-check" name="etapa" id="etapaSolicitud" value="SOLICITUD" checked />
                            <label class="btn btn-outline-primary" for="etapaSolicitud" style="min-height:40px">Solicitud</label>
                            @if (puedeEvidencia)
                            {
                                <input type="radio" class="btn-check" name="etapa" id="etapaAntes" value="ANTES" />
                                <label class="btn btn-outline-primary" for="etapaAntes" style="min-height:40px">Antes</label>
                                <input type="radio" class="btn-check" name="etapa" id="etapaDespues" value="DESPUES" />
                                <label class="btn btn-outline-primary" for="etapaDespues" style="min-height:40px">Después</label>
                            }
                        </div>
                    </div>
                    @{
                        ViewData["InputName"] = "archivos";
                        ViewData["Label"] = "Archivos";
                    }
                    <partial name="_AdjuntosInput" />
                    <button type="submit" class="btn btn-primary fara-btn-subir" id="btnSubirAdjuntos" style="min-height:40px">
                        <i class="ti ti-upload me-1"></i>Subir archivos
                    </button>
                </form>
            }
        </div>

        @if (a.PuedeEncuesta && Model.Encuesta == null)
        {
            <div class="border rounded p-3 mb-3 border-success">
                <h2 class="h6">Encuesta de satisfacción</h2>
                <form id="formEncuesta" class="row g-2">
                    <div class="col-12">
                        <label class="form-label">Calificación (1-5)</label>
                        <div class="d-flex gap-2 flex-wrap" id="estrellas">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="btn btn-outline-warning btn-estrella" data-val="@i" style="min-height:40px;min-width:40px">★</button>
                            }
                        </div>
                        <input type="hidden" name="calificacion" id="calificacion" value="5" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="conforme" id="conforme" value="true" checked />
                            <label class="form-check-label" for="conforme">Conforme con el servicio</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <textarea name="comentario" class="form-control" rows="2" placeholder="Comentario (opcional)"></textarea>
                    </div>
                    <div class="col-12"><button class="btn btn-success" style="min-height:40px">Enviar encuesta</button></div>
                </form>
            </div>
        }
        else if (Model.Encuesta != null)
        {
            <div class="border rounded p-3 mb-3">
                <h2 class="h6">Encuesta</h2>
                <p class="mb-0">Calificación: @Model.Encuesta.FiCalificacion / 5 · @(Model.Encuesta.FbConforme ? "Conforme" : "No conforme")</p>
                <p class="small text-muted mb-0">@Model.Encuesta.FcComentario</p>
            </div>
        }
    </div>

    <div class="col-12 col-lg-4">
        <div class="border rounded p-3 mb-3 fara-acciones-ticket">
            <h2 class="h6">Acciones</h2>
            <div class="d-grid gap-2">
                @if (a.PuedeEvaluar) { <button type="button" class="btn btn-outline-primary js-estado" data-estado="EN_EVALUACION" style="min-height:40px">Pasar a evaluación</button> }
                @if (a.PuedeAprobar) { <button type="button" class="btn btn-success js-estado" data-estado="APROBADO" style="min-height:40px">Aprobar</button> }
                @if (a.PuedeRechazar) { <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalRechazo" style="min-height:40px">Rechazar</button> }
                @if (a.PuedeCambiarPrioridad) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalPrioridad" style="min-height:40px">Cambiar prioridad</button> }
                @if (a.PuedeAsignar) { <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignar" style="min-height:40px">Asignar</button> }
                @if (a.PuedeIniciar) { <button type="button" class="btn btn-primary js-estado" data-estado="EN_PROCESO" style="min-height:40px">Iniciar trabajo</button> }
                @if (a.PuedePonerEspera) { <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEspera" style="min-height:40px">Poner en espera</button> }
                @if (a.PuedeSalirEspera) { <button type="button" class="btn btn-outline-primary js-estado" data-estado="EN_PROCESO" style="min-height:40px">Salir de espera</button> }
                @if (a.PuedeEjecucion) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalEjecucion" style="min-height:40px">Registrar ejecución</button> }
                @if (a.PuedeMateriales) { <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalMaterial" style="min-height:40px">Agregar material</button> }
                @if (a.PuedeResolver) { <button type="button" class="btn btn-success js-estado" data-estado="RESUELTO" style="min-height:40px">Marcar resuelto</button> }
                @if (a.PuedeCerrar) { <button type="button" class="btn btn-dark js-estado" data-estado="CERRADO" style="min-height:40px">Cerrar</button> }
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h2 class="h6">Línea de tiempo</h2>
            <ul class="list-unstyled small mb-0">
            @foreach (var h in Model.Historial)
            {
                <li class="mb-3 border-start border-3 ps-2" style="border-color:@(h.FcEstadoColor ?? "#ccc") !important">
                    <div class="fw-semibold">@h.FcEstadoNombre</div>
                    <div class="text-muted">@h.FdFecha.ToString("dd/MM/yyyy HH:mm") · @(h.FcUsuarioNombre ?? "Sistema")</div>
                    @if (!string.IsNullOrWhiteSpace(h.FcComentario)) { <div>@h.FcComentario</div> }
                    @if (!string.IsNullOrWhiteSpace(h.FcMotivoEsperaNombre)) { <div class="text-warning">Motivo: @h.FcMotivoEsperaNombre</div> }
                </li>
            }
            </ul>
        </div>

        <div class="border rounded p-3">
            <h2 class="h6">Comentarios</h2>
            @foreach (var c in Model.Comentarios)
            {
                <div class="mb-2 small @(c.FbInterno ? "bg-light p-2 rounded" : "")">
                    <div class="fw-semibold">@(c.FcUsuarioNombre ?? "Usuario") @(c.FbInterno ? "(interno)" : "")</div>
                    <div class="text-muted">@c.FdFecha.ToString("dd/MM/yyyy HH:mm")</div>
                    <div>@c.FcComentario</div>
                </div>
            }
            <form id="formComentario" class="mt-2">
                <textarea name="comentario" class="form-control mb-2" rows="2" required placeholder="Escriba un comentario"></textarea>
                @if (User.IsInRole("MANTENIMIENTO") || User.IsInRole("JEFATURA") || User.IsInRole("ADMIN"))
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="interno" value="true" id="interno" />
                        <label class="form-check-label" for="interno">Interno</label>
                    </div>
                }
                <button class="btn btn-outline-primary btn-sm" style="min-height:40px">Agregar</button>
            </form>
        </div>
    </div>
</div>

@* Modales *@
<div class="modal fade" id="modalRechazo" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Rechazar ticket</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><textarea id="txtRechazo" class="form-control" rows="3" placeholder="Motivo del rechazo"></textarea></div>
    <div class="modal-footer"><button class="btn btn-danger" id="btnRechazo" style="min-height:40px">Confirmar rechazo</button></div>
</div></div></div>

<div class="modal fade" id="modalEspera" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Poner en espera</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <select id="selMotivo" class="form-select mb-2">
            @if (combos != null) { foreach (var m in combos.MotivosEspera) { <option value="@m.FiId">@m.FcNombre</option> } }
        </select>
        <textarea id="txtEspera" class="form-control" rows="2" placeholder="Comentario"></textarea>
    </div>
    <div class="modal-footer"><button class="btn btn-warning" id="btnEspera" style="min-height:40px">Confirmar</button></div>
</div></div></div>

<div class="modal fade" id="modalPrioridad" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Cambiar prioridad</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <select id="selPrioridad" class="form-select">
            @if (combos != null)
            {
                foreach (var p in combos.Prioridades)
                {
                    if (p.FiId == t.FiPrioridadId)
                    {
                        <option value="@p.FiId" selected>@p.FcNombre</option>
                    }
                    else
                    {
                        <option value="@p.FiId">@p.FcNombre</option>
                    }
                }
            }
        </select>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnPrioridad" style="min-height:40px">Guardar</button></div>
</div></div></div>

<div class="modal fade" id="modalAsignar" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Asignar responsable</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <select id="selTipoResp" class="form-select mb-2" data-no-select2>
            <option value="INTERNO">Técnico interno</option>
            <option value="PROVEEDOR">Proveedor</option>
        </select>
        @* Sin select2: el toggle de técnico/proveedor oculta el select nativo y select2 lo dejaba visible *@
        <select id="selTecnico" class="form-select mb-2" data-no-select2>
            <option value="">Técnico...</option>
            @if (combos != null) { foreach (var x in combos.Tecnicos) { <option value="@x.FiId">@x.FcNombre</option> } }
        </select>
        <select id="selProveedor" class="form-select mb-2" style="display:none" data-no-select2>
            <option value="">Proveedor...</option>
            @if (combos != null) { foreach (var x in combos.Proveedores) { <option value="@x.FiId">@x.FcNombre</option> } }
        </select>
        <input type="datetime-local" id="fdProgramada" class="form-control" />
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnAsignar" style="min-height:40px">Asignar</button></div>
</div></div></div>

<div class="modal fade" id="modalEjecucion" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Ejecución</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body row g-2">
        <div class="col-md-6"><label class="form-label">Inicio</label><input type="datetime-local" id="ejInicio" class="form-control" value="@(t.FdFechaInicio?.ToString("yyyy-MM-ddTHH:mm"))" /></div>
        <div class="col-md-6"><label class="form-label">Fin</label><input type="datetime-local" id="ejFin" class="form-control" value="@(t.FdFechaFin?.ToString("yyyy-MM-ddTHH:mm"))" /></div>
        <div class="col-md-4"><label class="form-label">Horas</label><input type="number" step="0.01" id="ejHoras" class="form-control" value="@t.FnHorasTrabajadas" /></div>
        <div class="col-md-4"><label class="form-label">Costo mano obra (L)</label><input type="number" step="0.01" id="ejMano" class="form-control" value="@t.FnCostoManoObra" /></div>
        <div class="col-md-4"><label class="form-label">Costo proveedor (L)</label><input type="number" step="0.01" id="ejProv" class="form-control" value="@t.FnCostoProveedor" /></div>
        <div class="col-12"><label class="form-label">Diagnóstico</label><textarea id="ejDiag" class="form-control" rows="2">@t.FcDiagnostico</textarea></div>
        <div class="col-12"><label class="form-label">Causa raíz</label><textarea id="ejCausa" class="form-control" rows="2">@t.FcCausaRaiz</textarea></div>
        <div class="col-12"><label class="form-label">Trabajo realizado</label><textarea id="ejTrab" class="form-control" rows="2">@t.FcTrabajoRealizado</textarea></div>
        <div class="col-12"><label class="form-label">Acciones preventivas</label><textarea id="ejPrev" class="form-control" rows="2">@t.FcAccionesPreventivas</textarea></div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnEjecucion" style="min-height:40px">Guardar</button></div>
</div></div></div>

<div class="modal fade" id="modalMaterial" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Material</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body row g-2">
        <div class="col-12"><input id="matDesc" class="form-control" placeholder="Descripción" /></div>
        <div class="col-4"><input id="matCant" type="number" step="0.01" class="form-control" value="1" placeholder="Cant." /></div>
        <div class="col-4"><input id="matUnd" class="form-control" placeholder="Unidad" /></div>
        <div class="col-4"><input id="matCosto" type="number" step="0.01" class="form-control" value="0" placeholder="Costo L" /></div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnMaterial" style="min-height:40px">Guardar</button></div>
</div></div></div>

@section Scripts {
<script>
(function(){
    var id = @t.FiId;
    function reloadOk(resp){ if(resp && (resp.fbSucces===true||resp.fbSucces===1)) location.reload(); }
    $('.js-estado').on('click', function(){
        var est = $(this).data('estado');
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:est }).then(reloadOk);
    });
    $('#btnRechazo').on('click', function(){
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:'RECHAZADO', comentario:$('#txtRechazo').val() }).then(reloadOk);
    });
    $('#btnEspera').on('click', function(){
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:'EN_ESPERA', motivoEsperaId:$('#selMotivo').val(), comentario:$('#txtEspera').val() }).then(reloadOk);
    });
    $('#btnPrioridad').on('click', function(){
        ajaxPost('/Tickets/CambiarPrioridad', { id:id, prioridadId:$('#selPrioridad').val() }).then(reloadOk);
    });
    $('#selTipoResp').on('change', function(){
        var interno = this.value === 'INTERNO';
        $('#selTecnico').toggle(interno); $('#selProveedor').toggle(!interno);
    });
    $('#btnAsignar').on('click', function(){
        var tipo = $('#selTipoResp').val();
        ajaxPost('/Tickets/Asignar', {
            id:id, tipoResponsable:tipo,
            tecnicoId: tipo==='INTERNO' ? $('#selTecnico').val() : null,
            proveedorId: tipo==='PROVEEDOR' ? $('#selProveedor').val() : null,
            fechaProgramada: $('#fdProgramada').val() || null
        }).then(reloadOk);
    });
    $('#btnEjecucion').on('click', function(){
        ajaxPost('/Tickets/GuardarEjecucion', {
            id:id, fechaInicio:$('#ejInicio').val(), fechaFin:$('#ejFin').val(),
            horasTrabajadas:$('#ejHoras').val(), costoManoObra:$('#ejMano').val(), costoProveedor:$('#ejProv').val(),
            diagnostico:$('#ejDiag').val(), causaRaiz:$('#ejCausa').val(),
            trabajoRealizado:$('#ejTrab').val(), accionesPreventivas:$('#ejPrev').val()
        }).then(reloadOk);
    });
    $('#btnMaterial').on('click', function(){
        ajaxPost('/Tickets/GuardarMaterial', {
            id:id, descripcion:$('#matDesc').val(), cantidad:$('#matCant').val(),
            unidad:$('#matUnd').val(), costoUnitario:$('#matCosto').val()
        }).then(reloadOk);
    });
    $('#formComentario').on('submit', function(e){
        e.preventDefault();
        ajaxPost('/Tickets/Comentario', {
            id:id, comentario: this.comentario.value, interno: $('#interno').is(':checked')
        }).then(reloadOk);
    });
    $('.btn-estrella').on('click', function(){
        var v = $(this).data('val'); $('#calificacion').val(v);
        $('.btn-estrella').removeClass('btn-warning').addClass('btn-outline-warning');
        $('.btn-estrella').each(function(){ if($(this).data('val')<=v) $(this).removeClass('btn-outline-warning').addClass('btn-warning'); });
    }).filter('[data-val="5"]').trigger('click');
    $('#formEncuesta').on('submit', function(e){
        e.preventDefault();
        ajaxPost('/Tickets/Encuesta', {
            id:id, calificacion:$('#calificacion').val(),
            conforme:$('#conforme').is(':checked'), comentario:this.comentario.value
        }).then(reloadOk);
    });
    // Dropzone: sube los archivos uno por uno (el servidor valida cada uno) y muestra un resumen.
    $('#formAdjunto').on('submit', function(e){
        e.preventDefault();
        var form = this;
        var input = form.querySelector('.js-dropzone input[type="file"]');
        var archivos = input && input.files ? Array.prototype.slice.call(input.files) : [];
        var etapa = (form.querySelector('input[name="etapa"]:checked') || {}).value || 'SOLICITUD';
        if (!archivos.length) {
            FaraComun.mostrarMensaje({ fbSucces: false, fcMensaje: 'Seleccione o arrastre al menos un archivo.' });
            return;
        }
        var $btn = $('#btnSubirAdjuntos').prop('disabled', true);
        var ok = 0, errores = [];
        var cadena = $.Deferred().resolve().promise();
        archivos.forEach(function (f) {
            cadena = cadena.then(function () {
                var fd = new FormData();
                fd.append('id', id);
                fd.append('etapa', etapa);
                fd.append('archivo', f);
                return ajaxPost('/Tickets/SubirAdjunto', fd, { silent: true }).then(function (r) {
                    if (r && (r.fbSucces === true || r.fbSucces === 1)) ok++;
                    else errores.push(f.name + ': ' + ((r && r.fcMensaje) || 'error'));
                }, function (r) {
                    errores.push(f.name + ': ' + ((r && r.fcMensaje) || 'error'));
                    return $.Deferred().resolve().promise();
                });
            });
        });
        cadena.always(function () {
            $btn.prop('disabled', false);
            if (!errores.length) {
                FaraComun.toast(true, ok === 1 ? 'Archivo subido' : ok + ' archivos subidos');
                setTimeout(function () { location.reload(); }, 900);
                return;
            }
            var msg = (ok ? ok + ' subido(s). ' : '') + 'No se guardaron: ' + errores.join(' | ');
            FaraComun.mostrarMensaje({ fbSucces: false, fcMensaje: msg });
            if (ok) $(document).one('click', '.swal2-confirm', function () { location.reload(); });
        });
    });
})();
</script>
}
