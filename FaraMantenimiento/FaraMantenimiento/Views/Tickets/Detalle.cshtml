                <button type="button" class="btn btn-outline-secondary fara-btn-ahora" data-fara-ahora="#ejFin" title="Poner la fecha y hora actual" aria-label="Ahora"><i class="ti ti-clock"></i><span class="d-none d-sm-inline ms-1">Ahora</span></button>
