@* Recordatorio diario de SLA vencido (t9): solo ADMIN/JEFATURA/MANTENIMIENTO (ViewBag lo llena el controlador) y solo si el ticket está vencido y no resuelto/cerrado. *@
@if (ViewBag.RecordatorioSla is FM.OrigenDatos.Modelos.Tickets.TicketRecordatorioSlaModelo rs && rs.FbVencido && rs.FbAplica)
{
    var activos = !rs.FbSinRecordatorioSla;
    <div class="border rounded p-3 mt-3" id="fara-recordatorio-sla">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                <input class="form-check-input" type="checkbox" role="switch" id="swRecordatorioSla" style="width:2.6em;height:1.4em"
                       @(activos ? "checked" : "") data-ticket="@t.FiId" />
                <label class="form-check-label fw-semibold" for="swRecordatorioSla">
                    Recordatorios de SLA:
                    <span id="lblRecordatorioSla" class="fara-badge @(activos ? "fara-badge-activo" : "fara-badge-inactivo")">@(activos ? "activados" : "desactivados")</span>
                </label>
            </div>
        </div>
        <p class="text-muted small mb-0 mt-2">
            Correo diario mientras el ticket siga vencido. La primera alerta de vencimiento siempre se envía.
            @if (!activos && rs.FdSinRecordatorioSla.HasValue)
            {
                <span>Desactivados por @(rs.FcSinRecordatorioSlaPor ?? "—") el @rs.FdSinRecordatorioSla.Value.ToString("dd/MM/yyyy HH:mm").</span>
            }
        </p>
    </div>
}

@section Scripts {
<script>
(function(){
    var id = @t.FiId;
    function reloadOk(resp){ if(resp && (resp.fbSucces===true||resp.fbSucces===1)) location.reload(); }
    $('.js-estado').on('click', function(){
        var est = $(this).data('estado');
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:est }).then(reloadOk);
    });
    $('#btnRechazo').on('click', function(){
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:'RECHAZADO', comentario:$('#txtRechazo').val() }).then(reloadOk);
    });
    $('#btnEspera').on('click', function(){
        ajaxPost('/Tickets/CambiarEstado', { id:id, estado:'EN_ESPERA', motivoEsperaId:$('#selMotivo').val(), comentario:$('#txtEspera').val() }).then(reloadOk);
    });
    $('#btnPrioridad').on('click', function(){
        ajaxPost('/Tickets/CambiarPrioridad', { id:id, prioridadId:$('#selPrioridad').val() }).then(reloadOk);
    });
    // Callers: modalAsignar/modalMaterial. API: Buscar*Sap select2. User: "select2 con data-select2-ajax"
    var sapLang = {
        noResults: function(){ return 'No se encontraron resultados'; },
        searching: function(){ return 'Buscando...'; },
        inputTooShort: function(a){ var n=a.minimum-a.input.length; return 'Escriba '+n+' caracter'+(n===1?'':'es')+' más'; }
    };
    function initSapSelect2($el, url, $err, onSelect){
        if (!$el.length || $el.hasClass('select2-hidden-accessible')) return;
        $el.select2({
            theme: 'bootstrap-5', width: '100%', allowClear: true,
            // Si SAP respondió un aviso (p. ej. "SAP no está configurado") se muestra dentro de la lista,
            // porque la lista abierta tapa el aviso que está debajo del campo.
            language: $.extend({}, sapLang, { noResults: function(){ return $err.text() || sapLang.noResults(); } }),
            placeholder: $el.data('placeholder') || 'Buscar...',
            minimumInputLength: 2, dropdownParent: $el.closest('.modal'),
            ajax: {
                url: url, dataType: 'json', delay: 300,
                data: function(params){ return { q: params.term }; },
                processResults: function(data){
                    if (data && data.error) { $err.text(data.error).show(); }
                    else { $err.hide().text(''); }
                    return { results: (data && data.results) || [] };
                },
                error: function(){ $err.text('No se pudo consultar SAP.').show(); }
            }
        });
        if (onSelect) $el.on('select2:select', function(e){ onSelect(e.params.data); });
        $el.on('select2:clear', function(){ $err.hide().text(''); });
    }
    initSapSelect2($('#selArticuloSap'), '/Tickets/BuscarArticulosSap', $('#sapArtError'), function(d){
        $('#matCodigoSap').val(d.itemCode || d.id || '');
        $('#matDesc').val(d.itemName || '');
        if (d.unidad) $('#matUnd').val(d.unidad);
        if (d.costo != null) $('#matCosto').val(d.costo);
    });
    initSapSelect2($('#selProveedorSap'), '/Tickets/BuscarProveedoresSap', $('#sapProvError'), function(d){
        $('#provSapCodigo').val(d.cardCode || d.id || '');
        $('#provSapNombre').val(d.cardName || '');
    });
    $('#selTipoResp').on('change', function(){
        var interno = this.value === 'INTERNO';
        $('#wrapTecnico').toggle(interno);
        $('#wrapProveedorSap').toggle(!interno);
    });
    $('#btnAsignar').on('click', function(){
        var tipo = $('#selTipoResp').val();
        ajaxPost('/Tickets/Asignar', {
            id:id, tipoResponsable:tipo,
            tecnicoId: tipo==='INTERNO' ? $('#selTecnico').val() : null,
            proveedorId: null,
            proveedorSapCodigo: tipo==='PROVEEDOR' ? $('#provSapCodigo').val() : null,
            proveedorSapNombre: tipo==='PROVEEDOR' ? $('#provSapNombre').val() : null,
            fechaProgramada: $('#fdProgramada').val() || null
        }).then(reloadOk);
    });
    $('#btnEjecucion').on('click', function(){
        ajaxPost('/Tickets/GuardarEjecucion', {
            id:id, fechaInicio:$('#ejInicio').val(), fechaFin:$('#ejFin').val(),
            horasTrabajadas:$('#ejHoras').val(), costoManoObra:$('#ejMano').val(), costoProveedor:$('#ejProv').val(),
            diagnostico:$('#ejDiag').val(), causaRaiz:$('#ejCausa').val(),
            trabajoRealizado:$('#ejTrab').val(), accionesPreventivas:$('#ejPrev').val()
        }).then(reloadOk);
    });
    $('#btnMaterial').on('click', function(){
        ajaxPost('/Tickets/GuardarMaterial', {
            id:id, descripcion:$('#matDesc').val(), cantidad:$('#matCant').val(),
            unidad:$('#matUnd').val(), costoUnitario:$('#matCosto').val(),
            codigoSap: $('#matCodigoSap').val() || null
        }).then(reloadOk);
    });
    $('#formComentario').on('submit', function(e){
        e.preventDefault();
        ajaxPost('/Tickets/Comentario', {
            id:id, comentario: this.comentario.value, interno: $('#interno').is(':checked')
        }).then(reloadOk);
    });
    // Validar trabajo: estrellas llenas hasta la elegida; "No" exige comentario.
    var textosEstrella = ['', 'Muy mala', 'Mala', 'Regular', 'Buena', 'Excelente'];
    function pintarEstrellas(v){
        $('.btn-estrella').each(function(){
            var on = $(this).data('val') <= v;
            $(this).toggleClass('activa', on).attr('aria-checked', $(this).data('val') == v ? 'true' : 'false');
        });
        $('#txtEstrellas').text(v ? textosEstrella[v] : '');
    }
    $('.btn-estrella').on('click', function(){
        var v = $(this).data('val'); $('#calificacion').val(v); pintarEstrellas(v);
    });
    $('input[name="conforme"]').on('change', function(){
        var no = $('#conformeNo').is(':checked');
        $('#lblComentarioValidar').text(no ? 'Qué sigue fallando (obligatorio)' : 'Comentario (opcional)');
        $('#txtValidar').prop('required', no).attr('placeholder', no ? 'Describa qué sigue mal para que mantenimiento lo revise' : 'Cuéntenos cómo quedó el trabajo');
        $('#btnValidar').text(no ? 'Regresar a mantenimiento' : 'Validar trabajo')
            .toggleClass('btn-success', !no).toggleClass('btn-danger', no);
    });
    $('#formEncuesta').on('submit', function(e){
        e.preventDefault();
        var sel = $('input[name="conforme"]:checked').val();
        var cal = parseInt($('#calificacion').val() || '0', 10);
        var com = (this.comentario.value || '').trim();
        if (!sel) { FaraComun.mostrarMensaje({ fbSucces:false, fcMensaje:'Indique si el trabajo quedó bien o si sigue el problema.' }); return; }
        if (!cal) { FaraComun.mostrarMensaje({ fbSucces:false, fcMensaje:'Seleccione una calificación de 1 a 5 estrellas.' }); return; }
        if (sel === 'false' && !com) { FaraComun.mostrarMensaje({ fbSucces:false, fcMensaje:'Escriba qué sigue fallando para que mantenimiento lo revise.' }); $('#txtValidar').trigger('focus'); return; }
        ajaxPost('/Tickets/Encuesta', { id:id, calificacion:cal, conforme: sel === 'true', comentario: com }).then(reloadOk);
    });
    // Dropzone: sube los archivos uno por uno (el servidor valida cada uno) y muestra un resumen.
    $('#formAdjunto').on('submit', function(e){
        e.preventDefault();
        var form = this;
        var input = form.querySelector('.js-dropzone input[type="file"]');
        var archivos = input && input.files ? Array.prototype.slice.call(input.files) : [];
        var etapa = (form.querySelector('input[name="etapa"]:checked') || {}).value || 'SOLICITUD';
        if (!archivos.length) {
            FaraComun.mostrarMensaje({ fbSucces: false, fcMensaje: 'Seleccione o arrastre al menos un archivo.' });
            return;
        }
        var $btn = $('#btnSubirAdjuntos').prop('disabled', true);
        var ok = 0, errores = [];
        var cadena = $.Deferred().resolve().promise();
        archivos.forEach(function (f) {
            cadena = cadena.then(function () {
                var fd = new FormData();
                fd.append('id', id);
                fd.append('etapa', etapa);
                fd.append('archivo', f);
                return ajaxPost('/Tickets/SubirAdjunto', fd, { silent: true }).then(function (r) {
                    if (r && (r.fbSucces === true || r.fbSucces === 1)) ok++;
                    else errores.push(f.name + ': ' + ((r && r.fcMensaje) || 'error'));
                }, function (r) {
                    errores.push(f.name + ': ' + ((r && r.fcMensaje) || 'error'));
                    return $.Deferred().resolve().promise();
                });
            });
        });
        cadena.always(function () {
            $btn.prop('disabled', false);
            if (!errores.length) {
                FaraComun.toast(true, ok === 1 ? 'Archivo subido' : ok + ' archivos subidos');
                setTimeout(function () { location.reload(); }, 900);
                return;
            }
            var msg = (ok ? ok + ' subido(s). ' : '') + 'No se guardaron: ' + errores.join(' | ');
            FaraComun.mostrarMensaje({ fbSucces: false, fcMensaje: msg });
            if (ok) $(document).one('click', '.swal2-confirm', function () { location.reload(); });
        });
    });
})();
</script>
<script>
// Recordatorio diario de SLA (t9): confirmación con SweetAlert y toast al cambiar.
(function () {
    var sw = document.getElementById('swRecordatorioSla');
    if (!sw) return;
    sw.addEventListener('change', function () {
        var activar = sw.checked;      // estado pedido
        sw.checked = !activar;         // no cambia hasta confirmar
        Swal.fire({
            icon: 'question',
            title: activar ? '¿Activar recordatorios de SLA?' : '¿Desactivar recordatorios de SLA?',
            text: activar
                ? 'Se volverá a enviar el correo diario mientras el ticket siga vencido.'
                : 'Ya no se enviará el correo diario de este ticket mientras siga vencido. Quedará registrado en el ticket.',
            showCancelButton: true,
            confirmButtonText: activar ? 'Activar' : 'Desactivar',
            cancelButtonText: 'Cancelar'
        }).then(function (r) {
            if (!r.isConfirmed) return;
            sw.disabled = true;
            ajaxPost('/Tickets/RecordatorioSla', { id: sw.getAttribute('data-ticket'), desactivar: !activar }).then(function (resp) {
                sw.disabled = false;
                if (!resp || !(resp.fbSucces === true || resp.fbSucces === 1)) return;
                sw.checked = activar;
                var lbl = document.getElementById('lblRecordatorioSla');
                lbl.textContent = activar ? 'activados' : 'desactivados';
                lbl.className = 'fara-badge ' + (activar ? 'fara-badge-activo' : 'fara-badge-inactivo');
                setTimeout(function () { location.reload(); }, 1200);
            }, function () { sw.disabled = false; });
        });
    });
})();
</script>
}
