        </div>
        <div class="col-md-4"><label class="form-label" for="ejHoras">Horas trabajadas</label><input type="number" step="0.01" min="0" id="ejHoras" class="form-control" value="@t.FnHorasTrabajadas" /></div>
        <div class="col-md-4"><label class="form-label" for="ejMano">Costo mano de obra (L)</label><input type="number" step="0.01" min="0" id="ejMano" class="form-control" value="@t.FnCostoManoObra" /></div>
        <div class="col-md-4"><label class="form-label" for="ejProv">Costo proveedor (L)</label><input type="number" step="0.01" min="0" id="ejProv" class="form-control" value="@t.FnCostoProveedor" /></div>
        <div class="col-12"><label class="form-label" for="ejDiag">Diagnóstico</label><textarea id="ejDiag" class="form-control" rows="2">@t.FcDiagnostico</textarea></div>
        <div class="col-12"><label class="form-label" for="ejCausa">Causa raíz</label><textarea id="ejCausa" class="form-control" rows="2">@t.FcCausaRaiz</textarea></div>
        <div class="col-12"><label class="form-label" for="ejTrab">Trabajo realizado</label><textarea id="ejTrab" class="form-control" rows="2">@t.FcTrabajoRealizado</textarea></div>
        <div class="col-12"><label class="form-label" for="ejPrev">Acciones preventivas</label><textarea id="ejPrev" class="form-control" rows="2">@t.FcAccionesPreventivas</textarea></div>
    </div>
    <div class="modal-footer"><button class="btn btn-primary" id="btnEjecucion" style="min-height:40px">Guardar</button></div>
</div></div></div>

@* Callers: modalMaterial. API: BuscarArticulosSap + GuardarMaterial. Schema: ticketmaterial.fcCodigoSap. User: "busca el artículo SAP (select2...) se guarda código SAP + descripción + cantidad + costo" *@
<div class="modal fade" id="modalMaterial" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Agregar material</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body row g-3">
        <div class="col-12">
            <label class="form-label" for="selArticuloSap">Artículo SAP</label>
            <select id="selArticuloSap" class="form-select" data-select2-ajax data-placeholder="Buscar artículo SAP (mín. 2 letras)">
                <option value=""></option>
            </select>
            <div id="sapArtError" class="small text-danger mt-1" style="display:none"></div>
        </div>
        <div class="col-12">
            <label class="form-label" for="matDesc">Descripción</label>
