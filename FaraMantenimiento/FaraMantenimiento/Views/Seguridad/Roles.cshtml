@model IEnumerable<FM.OrigenDatos.Modelos.Seguridad.RolModelo>
@{
    ViewData["Title"] = "Roles";
    ViewData["SeguridadTab"] = "roles";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Roles</h1>
    <a class="btn btn-primary" asp-action="Rol" data-fara-modal data-fara-titulo="Nuevo rol" style="min-height:40px">Nuevo rol</a>
</div>
<partial name="_SeguridadNav" />

<div class="table-responsive d-none d-md-block">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th class="fara-col-accion">Acciones</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            var esAdmin = string.Equals(r.FcCodigo, "ADMIN", StringComparison.OrdinalIgnoreCase);
            <tr>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Rol" asp-route-id="@r.FiId"
                       data-fara-modal data-fara-titulo="Editar rol" style="min-height:40px">Editar</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="RolPermisos" asp-route-id="@r.FiId" style="min-height:40px">Permisos</a>
                    @if (!(esAdmin && r.FbActivo))
                    {
                        <form asp-action="ActivarRol" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.FiId" />
                            <input type="hidden" name="activo" value="@(!r.FbActivo)" />
                            <button type="submit" class="btn btn-sm @(r.FbActivo ? "btn-outline-danger" : "btn-outline-success")" style="min-height:40px">
                                @(r.FbActivo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    }
                </td>
                <td>@r.FcCodigo</td>
                <td>@r.FcNombre</td>
                <td>@r.FcDescripcion</td>
                <td>
                    @if (r.FbActivo)
                    {
                        <span class="fara-badge fara-badge-activo">Activo</span>
                    }
                    else
                    {
                        <span class="fara-badge fara-badge-inactivo">Inactivo</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="d-md-none d-flex flex-column gap-3">
@foreach (var r in Model)
{
    <div class="border rounded p-3">
        <div class="fw-semibold">@r.FcNombre <span class="text-muted small">(@r.FcCodigo)</span></div>
        <div class="small mb-2">@r.FcDescripcion</div>
        <a class="btn btn-sm btn-outline-primary me-1" asp-action="Rol" asp-route-id="@r.FiId" style="min-height:40px">Editar</a>
        <a class="btn btn-sm btn-outline-secondary" asp-action="RolPermisos" asp-route-id="@r.FiId" style="min-height:40px">Permisos</a>
    </div>
}
</div>
