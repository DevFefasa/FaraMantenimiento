@model FM.OrigenDatos.Modelos.Seguridad.UsuarioModelo
@{
    ViewData["Title"] = Model.FiId > 0 ? "Editar usuario" : "Nuevo usuario";
    var roles = (IEnumerable<FM.OrigenDatos.Modelos.Seguridad.RolModelo>)ViewBag.Roles;
}
<h1 class="h4 mb-3">@ViewData["Title"]</h1>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<form method="post" asp-action="Usuario" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="fiId" value="@Model.FiId" />
    <div class="col-12 col-md-6">
        <label class="form-label">Usuario</label>
        <input name="fcUsuario" class="form-control" value="@Model.FcUsuario" required />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Nombre</label>
        <input name="fcNombre" class="form-control" value="@Model.FcNombre" required />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Cargo</label>
        <input name="fcCargo" class="form-control" value="@Model.FcCargo" />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Correo</label>
        <input name="fcCorreo" type="email" class="form-control" value="@Model.FcCorreo" />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Teléfono</label>
        <input name="fcTelefono" class="form-control" value="@Model.FcTelefono" />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Rol</label>
        <select name="fiRolId" class="form-select" required>
            @foreach (var r in roles)
            {
                if (r.FiId == Model.FiRolId)
                {
                    <option value="@r.FiId" selected>@r.FcNombre</option>
                }
                else
                {
                    <option value="@r.FiId">@r.FcNombre</option>
                }
            }
        </select>
    </div>
    <div class="col-12 col-md-6">
        <div class="form-check mt-4">
            <input type="hidden" name="fbEsLocal" value="false" />
            <input class="form-check-input" type="checkbox" name="fbEsLocal" value="true" id="fbEsLocal" @(Model.FbEsLocal ? "checked" : null) />
            <label class="form-check-label" for="fbEsLocal">Usuario local</label>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Nueva contraseña (opcional)</label>
        <input name="contrasenaNueva" type="password" class="form-control" autocomplete="new-password" />
        <div class="form-text">Si queda vacío y no tiene hash, usará la clave maestra Auth:LocalPassword.</div>
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary" style="min-height:40px">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary" style="min-height:40px">Cancelar</a>
    </div>
</form>
