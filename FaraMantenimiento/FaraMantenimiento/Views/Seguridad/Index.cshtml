@model IEnumerable<FM.OrigenDatos.Modelos.Seguridad.UsuarioModelo>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SeguridadTab"] = "usuarios";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Usuarios</h1>
    <a class="btn btn-primary" asp-action="Usuario" data-fara-modal data-fara-titulo="Nuevo usuario" style="min-height:40px">Nuevo usuario</a>
</div>
<partial name="_SeguridadNav" />

<div class="table-responsive d-none d-md-block">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th class="fara-col-accion">Acciones</th>
                <th>Usuario</th>
                <th>Usuario AD</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th>Área</th>
                <th>Departamento</th>
                <th>Jefe</th>
                <th>Correo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Usuario" asp-route-id="@u.FiId"
                       data-fara-modal data-fara-titulo="Editar usuario" style="min-height:40px">Editar</a>
                    <form asp-action="ActivarUsuario" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@u.FiId" />
                        <input type="hidden" name="activo" value="@(!u.FbActivo)" />
                        <button type="submit" class="btn btn-sm @(u.FbActivo ? "btn-outline-danger" : "btn-outline-success")" style="min-height:40px">
                            @(u.FbActivo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
                <td>@u.FcUsuario</td>
                <td>@u.FcActiveDirectory</td>
                <td>@u.FcNombre</td>
                <td>@u.FcRolNombre</td>
                <td>@u.FcAreaNombre</td>
                <td>@u.FcDepartamentoNombre</td>
                <td>@u.FcJefeNombre</td>
                <td>@u.FcCorreo</td>
                <td>
                    @if (u.FbActivo)
                    {
                        <span class="fara-badge fara-badge-activo">Activo</span>
                    }
                    else
                    {
                        <span class="fara-badge fara-badge-inactivo">Inactivo</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="d-md-none d-flex flex-column gap-3">
@foreach (var u in Model)
{
    <div class="border rounded p-3">
        <div class="fw-semibold">@u.FcNombre</div>
        <div class="text-muted small mb-2">@u.FcUsuario@(string.IsNullOrWhiteSpace(u.FcActiveDirectory) ? "" : " · AD: " + u.FcActiveDirectory) · @u.FcRolNombre@(string.IsNullOrWhiteSpace(u.FcAreaNombre) ? "" : " · " + u.FcAreaNombre)@(string.IsNullOrWhiteSpace(u.FcDepartamentoNombre) ? "" : " / " + u.FcDepartamentoNombre)@(string.IsNullOrWhiteSpace(u.FcJefeNombre) ? "" : " · Jefe: " + u.FcJefeNombre)</div>
        <div class="mb-2">
            @if (u.FbActivo)
            {
                <span class="fara-badge fara-badge-activo">Activo</span>
            }
            else
            {
                <span class="fara-badge fara-badge-inactivo">Inactivo</span>
            }
        </div>
        <a class="btn btn-sm btn-outline-primary me-1" asp-action="Usuario" asp-route-id="@u.FiId" style="min-height:40px">Editar</a>
        <form asp-action="ActivarUsuario" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@u.FiId" />
            <input type="hidden" name="activo" value="@(!u.FbActivo)" />
            <button type="submit" class="btn btn-sm @(u.FbActivo ? "btn-outline-danger" : "btn-outline-success")" style="min-height:40px">
                @(u.FbActivo ? "Desactivar" : "Activar")
            </button>
        </form>
    </div>
}
</div>
